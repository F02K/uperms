{
  "name": "uperms",
  "version": "0.1.0",
  "private": true,
  "description": "Standalone permission system: hierarchical nodes, groups with inheritance, deny/allow rules, expiry and pluggable conditions. Storage is a JSON file or MySQL, chosen in config.json.",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test tests/*.test.cjs",
    "check": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "@types/node": "22.16.0"
  },
  "mafiahub": {
    "serverScripts": [
      "dist/server/index.js"
    ],
    "exports": [
      "can",
      "check",
      "require",
      "grant",
      "revoke",
      "addToGroup",
      "removeFromGroup",
      "listNodes",
      "registerCondition",
      "getGroups",
      "getSubject",
      "isReady"
    ],
    "errorBehavior": "stop"
  },
  "dependencies": {
    "mysql2": "^3.14.0"
  }
}
