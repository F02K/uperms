{
  "compilerOptions": {
    "target": "ES2022", "module": "CommonJS", "moduleResolution": "node",
    "lib": ["ES2022"], "types": ["node"], "rootDir": "src/server", "outDir": "dist/server",
    "strict": true, "noUncheckedIndexedAccess": true, "noUnusedLocals": true,
    "noUnusedParameters": true, "noEmitOnError": true, "skipLibCheck": true
  },
  "include": ["src/server/**/*.ts", "types/generated/server-api.d.ts"]
}
